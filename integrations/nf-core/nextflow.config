params {
    mode                 = 'bulk'   // 'bulk' or 'smartseq3'
    species              = 'human'  // 'human' or 'mouse'
    outdir               = './results'
    fasta                = null
    fai                  = null
    gtf                  = null
    gmt                  = null
    // Bulk inputs
    rmats                = null
    usage                = null
    samples              = null
    support              = null
    annotation           = null
    // Single-cell Smart-seq3 inputs
    events               = null
    psi                  = null
    metadata             = null
    numerator            = 'Stim'
    denominator          = 'Ctrl'
}

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy'
    ]
    withName: '.*SPLICETRACE' {
        ext.args = { "--species ${params.species}" }
    }
}

profiles {
    conda {
        conda.enabled = true
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
