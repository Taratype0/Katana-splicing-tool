nextflow.enable.dsl = 2

params {
    mode = 'complete'
    input = null
    contrasts = null
    fasta = null
    gtf = null
    project = null
    project_template = null
    flow_config = null
    flow_plan = null
    flow_report_revision = '1'
    flow_executable = 'katana-flow'
    katana_container = null
    // Optional exact execution-group overrides. Control uses the full image.
    katana_stage_containers = [:]
    outdir = 'results'
    publish_dir_mode = 'copy'
    help = false

    // Existing upstream scientific defaults; institutional admission is external.
    genome = null
    reference_build = null
    annotation_release = null
    read_length = null
    allow_variable_read_length = true
    design = '~ condition'
    analysis_purpose = 'analysis'
    skip_trimming = false
    skip_fastqc = false
    star_index = null
    star_sjdb_overhang = 99
    star_genome_sa_index_nbases = null
    salmon_archive = 'https://github.com/COMBINE-lab/salmon/releases/download/v2.8.0/salmon-cli-x86_64-unknown-linux-gnu.tar.xz'
    salmon_archive_sha256 = '10a7f7994df7ef0592ac191cc79a1abd41316463000b307647a9dcab21e1efa6'
    salmon_seq_bias = true
    salmon_gc_bias = true
    alignment_quality = 10
    aggregation = true
    n_dexseq_plot = 10
    min_samps_feature_expr = 2
    min_samps_feature_prop = 2
    min_samps_gene_expr = 4
    min_feature_expr = 10
    min_feature_prop = 0.1
    min_gene_expr = 10
    rmats_splice_diff_cutoff = 0.0001
    rmats_novel_splice_site = false
    rmats_min_intron_len = 50
    rmats_max_exon_len = 500
    suppa_per_local_event = true
    suppa_per_isoform = true
    generateevents_pool_genes = true
    generateevents_event_type = 'SE SS MX RI FL'
    generateevents_boundary = 'S'
    generateevents_threshold = 10
    generateevents_exon_length = 100
    psiperevent_total_filter = 0
    diffsplice_local_event = true
    diffsplice_isoform = true
    diffsplice_method = 'empirical'
    diffsplice_area = 1000
    diffsplice_lower_bound = 0
    diffsplice_gene_correction = true
    diffsplice_alpha = 0.05
    diffsplice_median = false
    diffsplice_tpm_threshold = 0
    diffsplice_nan_threshold = 0
    clusterevents_local_event = false
    clusterevents_isoform = false
    clusterevents_sigthreshold = null
    clusterevents_dpsithreshold = 0.05
    clusterevents_eps = 0.05
    clusterevents_metric = 'euclidean'
    clusterevents_separation = null
    clusterevents_min_pts = 20
    clusterevents_method = 'DBSCAN'

    slurm_account = null
    slurm_partition = null
    max_cpus = null
    max_memory = null
    max_time = null
}

includeConfig 'conf/upstream_base.config'
includeConfig 'conf/upstream_modules.config'

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    // Only Katana processes receive this isolation; upstream tool images keep
    // their declared runtime options. Mounted data never authorizes host tools.
    withLabel: /katana_(control|downstream|report)/ {
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? '--cleanenv' : '' }
    }
    // This is a per-task request, never an application-wide concurrency cap.
    withName: 'STAR_GENOMEGENERATE' {
        cpus = 16
        memory = { task.attempt == 1 ? 96.GB : 128.GB }
    }
    withLabel: katana_control {
        cpus = 1
        memory = 4.GB
        time = 2.h
        container = { params.katana_stage_containers?.get('control') ?: params.katana_container }
        publishDir = [path: '.', enabled: false]
        errorStrategy = 'terminate'
    }
    withLabel: katana_downstream {
        cpus = { spec.resources?.cpus ?: 1 }
        memory = { spec.resources?.memory ?: '8 GB' }
        time = { spec.resources?.time ?: '12 h' }
        container = { params.katana_stage_containers?.get(spec.execution_group) ?: params.katana_container }
        publishDir = [path: "${params.outdir}/downstream", mode: 'copy']
        // Report failure, but let already submitted independent work finish so
        // successful tasks can be reused with -resume. No automatic retry.
        errorStrategy = 'finish'
    }
    withLabel: katana_report {
        cpus = 2
        memory = 12.GB
        time = 8.h
        container = { params.katana_stage_containers?.get('report') ?: params.katana_container }
        publishDir = [path: params.outdir, mode: 'copy']
        errorStrategy = 'terminate'
    }
}

// Optional resource ceilings are explicit user settings, not hidden site limits.
def ceilings = [:]
if (params.max_cpus != null) ceilings.cpus = params.max_cpus
if (params.max_memory != null) ceilings.memory = params.max_memory
if (params.max_time != null) ceilings.time = params.max_time
if (ceilings) process.resourceLimits = ceilings

profiles {
    local { process.executor = 'local' }
    docker { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    apptainer { apptainer.enabled = true; apptainer.autoMounts = true }
    conda { conda.enabled = true; conda.channels = ['conda-forge', 'bioconda'] }
    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_partition
        process.clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
        executor.queueSize = 0
    }
}

env {
    PYTHONNOUSERSITE = '1'
    MPLBACKEND = 'Agg'
    QT_QPA_PLATFORM = 'offscreen'
}

// Do not put this timestamp in params: a fresh value must not enter scientific
// task fingerprints and invalidate every result when -resume is requested.
def executionTraceSuffix = new java.text.SimpleDateFormat('yyyyMMdd-HHmmss-SSS').format(new Date())
trace { enabled = true; file = "${params.outdir}/pipeline_info/trace-${executionTraceSuffix}.tsv" }
report { enabled = true; file = "${params.outdir}/pipeline_info/nextflow-report-${executionTraceSuffix}.html" }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline-${executionTraceSuffix}.html" }
dag { enabled = true; file = "${params.outdir}/pipeline_info/dag-${executionTraceSuffix}.html" }

manifest {
    name = 'taratype0/katana'
    description = 'Bulk RNA-seq upstream, Katana analysis and the approved seven-section report'
    nextflowVersion = '!>=25.10.4'
    version = '2.0.0-dev'
    mainScript = 'main.nf'
}
