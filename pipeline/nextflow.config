nextflow.enable.dsl = 2

params {
    output_layout = 'standard'
    native_delivery = true
    bundle = null
    design_factors = ['condition']
    clean_work = false
    mode = 'complete'
    input = null
    contrasts = null
    fasta = null
    gtf = null
    project = null
    project_template = null
    flow_config = null
    flow_plan = null
    flow_report_revision = '1'
    flow_executable = 'katana-flow'
    katana_container = 'docker.io/j387735517/katana-downstream:2.0.0b5.dev2026110403'
    dexseq_tools_container = 'docker.io/j387735517/katana-dexseq-tools@sha256:20efe62e4679d6437c21938c624f7fdb18cc3c7fa8289456e1a73d9086b29717'
    // Optional exact execution-group overrides. Control uses the full image.
    katana_stage_containers = [:]
    // Optional delivery-only repair: preserve analysis image/cache identities.
    retention_container = null
    outdir = 'results'
    publish_dir_mode = 'copy'
    // lean is selected by the managed runner; direct native runs stay compatible.
    storage_mode = 'retain'
    managed_preflight = false
    help = false

    // Public downstream options. JSON transport files are generated internally.
    study_name = 'Katana study'
    species = null
    gene_sets = null
    rbp_gene_sets = null
    motif_database = null
    clip_peaks = null
    fimo_runtime = null
    resource_metadata = [:]
    resource_bundle = 'auto'
    resource_cache = "${launchDir}/.katana-cache/resources"
    verify_content = false
    digest_cache = "${launchDir}/.katana-cache/checksums"
    contrast_ids = null
    rmats_mode = 'JCEC'
    event_set = 'stable_significant'
    deg_fdr = 0.05
    deg_log2fc = 1.0
    das_fdr = 0.05
    das_dpsi = 0.10
    dtu_fdr = 0.05
    network_min_module_size = 20
    network_merge_cut_height = 0.25
    skip_landscape = false
    skip_cross_comparison = false
    skip_enrichment = false
    skip_rbp_identity = false
    skip_motiftrace = false
    skip_motif_binding = false
    skip_mapp = false
    skip_network = false
    skip_interaction = false
    skip_sequencing_qc = false
    with_genebody_coverage = false
    with_network_bootstrap = false

    // Existing upstream scientific defaults; institutional admission is external.
    genome = null
    reference_build = null
    annotation_release = null
    read_length = null
    allow_variable_read_length = true
    // nf-core strand-classification thresholds; RSeQC native sampling defaults.
    stranded_threshold = 0.8
    unstranded_threshold = 0.1
    strandedness_sample_size = 200000
    strandedness_mapq = 30
    design = '~ condition'
    analysis_purpose = 'analysis'
    skip_trimming = false
    skip_fastqc = false
    star_index = null
    star_sjdb_overhang = 99
    star_genome_sa_index_nbases = null
    salmon_archive = 'https://github.com/COMBINE-lab/salmon/releases/download/v2.8.0/salmon-cli-x86_64-unknown-linux-gnu.tar.xz'
    salmon_archive_sha256 = '10a7f7994df7ef0592ac191cc79a1abd41316463000b307647a9dcab21e1efa6'
    salmon_seq_bias = true
    salmon_gc_bias = true
    alignment_quality = 10
    aggregation = true
    n_dexseq_plot = 10
    min_samps_feature_expr = 2
    min_samps_feature_prop = 2
    min_samps_gene_expr = 4
    min_feature_expr = 10
    min_feature_prop = 0.1
    min_gene_expr = 10
    rmats_splice_diff_cutoff = 0.0001
    rmats_novel_splice_site = false
    rmats_min_intron_len = 50
    rmats_max_exon_len = 500
    suppa_per_local_event = true
    suppa_per_isoform = true
    generateevents_pool_genes = true
    generateevents_event_type = 'SE SS MX RI FL'
    generateevents_boundary = 'S'
    generateevents_threshold = 10
    generateevents_exon_length = 100
    psiperevent_total_filter = 0
    diffsplice_local_event = true
    diffsplice_isoform = true
    diffsplice_method = 'empirical'
    diffsplice_area = 1000
    diffsplice_lower_bound = 0
    diffsplice_gene_correction = true
    diffsplice_alpha = 0.05
    diffsplice_median = false
    diffsplice_tpm_threshold = 0
    diffsplice_nan_threshold = 0
    clusterevents_local_event = false
    clusterevents_isoform = false
    clusterevents_sigthreshold = null
    clusterevents_dpsithreshold = 0.05
    clusterevents_eps = 0.05
    clusterevents_metric = 'euclidean'
    clusterevents_separation = null
    clusterevents_min_pts = 20
    clusterevents_method = 'DBSCAN'

    slurm_account = null
    slurm_partition = null
    max_cpus = null
    max_memory = null
    max_time = null
}

// Create only cache directories, never launch a calculation in configuration.
[params.resource_cache, params.digest_cache].each { directory ->
    if (directory.toString() =~ /[:,\n\r]/) throw new IllegalArgumentException('Cache paths cannot contain commas, colons or newlines')
    java.nio.file.Files.createDirectories(java.nio.file.Paths.get(directory.toString()).toAbsolutePath())
}
includeConfig 'conf/upstream_base.config'
includeConfig 'conf/upstream_modules.config'
includeConfig 'conf/upstream_task_resources.config'

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    // Download small reference databases on the Nextflow launch host, where
    // network access is available. Scientific tasks keep the site's executor.
    // A named selector survives a site's generic process.executor='slurm'.
    withName: 'KATANA_FLOW_CONFIGURE' {
        executor = 'local'
    }
    // Only Katana processes receive this isolation; upstream tool images keep
    // their declared runtime options. Mounted data never authorizes host tools.
    withLabel: /katana_(control|downstream|report|io)/ {
        // A string task option avoids hashing mutable work-directory metadata.
        ext.katana_owned_work_root = { workflow.workDir.toString() }
        containerOptions = {
            def mounts = [params.resource_cache, params.digest_cache].collect {
                def path = java.nio.file.Paths.get(it.toString()).toAbsolutePath().normalize().toString()
                workflow.containerEngine in ['singularity', 'apptainer'] ? "--bind '${path}:${path}'" : "-v '${path}:${path}'"
            }.join(' ')
            workflow.containerEngine in ['singularity', 'apptainer'] ? "--cleanenv ${mounts}" : (workflow.containerEngine == 'docker' ? mounts : '')
        }
    }
    // This is a per-task request, never an application-wide concurrency cap.
    withName: 'STAR_GENOMEGENERATE' {
        cpus = 16
        memory = { task.attempt == 1 ? 96.GB : 128.GB }
    }
    withLabel: katana_control {
        cpus = 1
        memory = 4.GB
        time = 2.h
        container = { (params.containsKey('katana_stage_containers') ? params.katana_stage_containers.get('control') : null) ?: (params.containsKey('katana_container') ? params.katana_container : null) }
        publishDir = [path: '.', enabled: false]
        errorStrategy = 'terminate'
    }
    withLabel: katana_downstream {
        container = { (params.containsKey('katana_stage_containers') ? params.katana_stage_containers.get(spec.execution_group) : null) ?: (params.containsKey('katana_container') ? params.katana_container : null) }
        publishDir = [path: { "${params.outdir}/downstream" }, mode: 'copy', enabled: "${ -> params.storage_mode != 'lean' }"]
        // Retry a resource/signal termination once in the SAME selected queue.
        errorStrategy = { task.exitStatus in [104, 130, 134, 137, 139, 143, 175, 176, 177] ? 'retry' : 'finish' }
        maxRetries = 1
        maxErrors = -1
    }
    withLabel: katana_report {
        cpus = 2
        memory = 12.GB
        time = 8.h
        container = { (params.containsKey('katana_stage_containers') ? params.katana_stage_containers.get('report') : null) ?: (params.containsKey('katana_container') ? params.katana_container : null) }
        publishDir = [path: { params.outdir }, mode: 'copy']
        errorStrategy = 'terminate'
    }
    withName: 'KATANA_FLOW_COLLECT' {
        publishDir = [path: { params.outdir }, mode: 'copy', enabled: "${ -> params.storage_mode == 'lean' }"]
    }
    withName: 'KATANA_FLOW_RETAIN|KATANA_FLOW_DELIVERY' {
        container = { params.retention_container ?: (params.katana_stage_containers.get('control') ?: params.katana_container) }
    }
    withName: 'KATANA_FLOW_CONFIGURE' {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy']
    }
}

// Tool requests are separate from site executor/queue choices.
includeConfig 'conf/task_resources.config'
includeConfig 'conf/portable_resources.config'

// Nextflow removes its own work only after the whole DAG succeeds, including
// delivery verification and publication. Failed runs retain their resume cache.
cleanup = params.clean_work

// Native publication and delivery are the public entry. Historical managed
// sessions explicitly select legacy paths to preserve their existing contract.
if (params.output_layout == 'standard') {
    includeConfig 'conf/standard_outputs.config'
}

// Optional resource ceilings are explicit user settings, not hidden site limits.
def ceilings = [:]
if (params.max_cpus != null) ceilings.cpus = params.max_cpus
if (params.max_memory != null) ceilings.memory = params.max_memory
if (params.max_time != null) ceilings.time = params.max_time
if (ceilings) process.resourceLimits = ceilings

profiles {
    local { process.executor = 'local' }
    docker {
        docker.enabled = true
        // Keep private tool directories readable by the calling Nextflow user.
        docker.runOptions = '--user $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true; singularity.autoMounts = true
        params.katana_container = 'https://github.com/Taratype0/Katana-splicing-tool/releases/download/v2.0.0-beta.5.dev2026110403/katana-downstream-2.0.0b5.dev2026110403-linux-amd64.sif'
        params.dexseq_tools_container = 'https://github.com/Taratype0/Katana-splicing-tool/releases/download/v2.0.0-beta.5.dev20261028/kanata-dexseq-tools-20261024-linux-amd64.sif'
    }
    apptainer {
        apptainer.enabled = true; apptainer.autoMounts = true
        params.katana_container = 'https://github.com/Taratype0/Katana-splicing-tool/releases/download/v2.0.0-beta.5.dev2026110403/katana-downstream-2.0.0b5.dev2026110403-linux-amd64.sif'
        params.dexseq_tools_container = 'https://github.com/Taratype0/Katana-splicing-tool/releases/download/v2.0.0-beta.5.dev20261028/kanata-dexseq-tools-20261024-linux-amd64.sif'
    }
    conda { conda.enabled = true; conda.channels = ['conda-forge', 'bioconda'] }
    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_partition
        process.clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
        executor.queueSize = 0
    }
    pdc_kth { includeConfig 'conf/pdc_kth.config' }
}

env {
    KATANA_VERIFY_CONTENT = params.verify_content ? '1' : '0'
    KATANA_DIGEST_CACHE = java.nio.file.Paths.get(params.digest_cache.toString()).toAbsolutePath().normalize().toString()
    PYTHONNOUSERSITE = '1'
    MPLBACKEND = 'Agg'
    QT_QPA_PLATFORM = 'offscreen'
}

// Do not put this timestamp in params: a fresh value must not enter scientific
// task fingerprints and invalidate every result when -resume is requested.
def executionTraceSuffix = new java.text.SimpleDateFormat('yyyyMMdd-HHmmss-SSS').format(new Date())
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace-${executionTraceSuffix}.tsv"
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,queue,cpus,memory,time,attempt,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report { enabled = true; file = "${params.outdir}/pipeline_info/nextflow-report-${executionTraceSuffix}.html" }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline-${executionTraceSuffix}.html" }
dag { enabled = true; file = "${params.outdir}/pipeline_info/dag-${executionTraceSuffix}.html" }

manifest {
    name = 'taratype0/katana'
    description = 'Bulk RNA-seq upstream, Katana analysis and the approved seven-section report'
    nextflowVersion = '!>=25.10.4'
    version = '2.0.0-dev'
    mainScript = 'main.nf'
}
