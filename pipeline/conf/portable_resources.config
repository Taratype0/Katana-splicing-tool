// Execution-only refinements. Scientific commands and imported modules stay intact.
// Memory/time may grow on retry; worker counts do not grow merely after an OOM.
process {
    cpus = 1
    withLabel: process_single { cpus = 1 }
    withLabel: process_low { cpus = 2 }
    withLabel: process_medium { cpus = 6 }
    withLabel: process_high { cpus = 12 }

    // These invocations have no parallel worker argument. Measured memory
    // overrides below are independent of the original broad nf-core labels.
    withName: '(ADAPT_SUPPA_CONTRASTS|ANALYSIS_TRANSCRIPTS|AUDIT_GENOME_BAM|GFFREAD_TX2GENE|KATANA_TXIMPORT|TXIMPORT|DRIMSEQ_FILTER|STAGER|CLUSTEREVENTS|DIFFSPLICE|GENERATE_EVENTS|PSIPEREVENT|PSIPERISOFORM|SPLIT_FILES|VALIDATE_INPUTS|VALIDATE_REFERENCE|KATANA_EXPORT)' {
        cpus = 1
    }
    // Streaming metadata and reference tasks: observed reference preparation
    // <0.8 GiB in rescue; 4 GiB retains headroom without generic 12 GiB requests.
    withName: '(ADAPT_SUPPA_CONTRASTS|ANALYSIS_TRANSCRIPTS|GFFREAD_TX2GENE|VALIDATE_INPUTS|VALIDATE_REFERENCE|PREPARE_REFERENCES)' {
        cpus = 1
        memory = { 4.GB * task.attempt }
    }
    // Twelve full mouse libraries: FastQC peak 1.1 GiB; trimming peak 4.1 GiB.
    // Requests are initial headroom, not universal peak guarantees.
    withName: 'FASTQC' { cpus = 2; memory = { 4.GB * task.attempt } }
    withName: 'DEXSEQ_(EXON|DTU)' { cpus = 6 }
    withName: 'TRIMGALORE' {
        cpus = 8
        memory = { 8.GB * task.attempt }
    }
    // Samtools alignment streaming plus a single-pass AWK accumulator.
    withName: 'CAPTURE_BAM_AUDIT' {
        cpus = 2
        memory = { 6.GB * task.attempt }
    }

    // Completed native bulk runs: see assets/measured-resources.json. These
    // are starting requests with headroom, not input/event-count restrictions.
    withName: '(DIFFSPLICE|GENERATE_EVENTS|PSIPEREVENT|PSIPERISOFORM)' {
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withName: '(KATANA_TXIMPORT|TXIMPORT|DRIMSEQ_FILTER|STAGER)' {
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withName: '(AUDIT_GENOME_BAM|SPLIT_FILES|SAMTOOLS_INDEX)' {
        memory = { 2.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withName: 'COLLATE_GENOME_BAM' {
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: 'SALMON_GENOME_PROJECTION' {
        memory = { 12.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: 'DEXSEQ_DTU' { memory = { 8.GB * task.attempt } }
    withName: 'DEXSEQ_EXON' { memory = { 16.GB * task.attempt } }
    withName: 'KATANA_EXPORT' { memory = { 4.GB * task.attempt } }
    withName: 'KATANA_FLOW_REPORT' { memory = { 8.GB * task.attempt } }

    // The measured post-only records are unpaired. Do not infer PAIRADISE's
    // memory from them, or from a combined prep+post execution. Pair identity
    // remains a declared input, never guessed from sample count or names.
    withName: 'RMATS_POST' {
        memory = {
            def paired = rmats_paired_stats instanceof Map ? rmats_paired_stats[contrast] : rmats_paired_stats
            if (paired == null) throw new IllegalArgumentException("Missing paired-model declaration: ${contrast}")
            (paired ? 72.GB : 8.GB) * task.attempt
        }
        time = {
            def paired = rmats_paired_stats instanceof Map ? rmats_paired_stats[contrast] : rmats_paired_stats
            if (paired == null) throw new IllegalArgumentException("Missing paired-model declaration: ${contrast}")
            (paired ? 16.h : 4.h) * task.attempt
        }
    }
}
