// Publication only. Scientific commands and channels are unchanged.
// Keep legacy paths for an explicitly selected historical managed run.
def standard = { params.output_layout == 'standard' }
def destination = { current, previous -> "${params.outdir}/${standard() ? current : previous}" }

process {
    // Finish promptly on a non-recoverable failure; resume reuses completed
    // tasks. Do not leave a failed controller waiting on unstarted queue jobs.
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'terminate' }
    publishDir = [path: { "${params.outdir}/rnaseq/auxiliary/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy', saveAs: { name ->
            def base = name.toString().tokenize('/').last()
            if (base ==~ /.*\.(bam|bai|fq|fastq|fa|fasta|gtf|gff)(\.gz)?/) return null
            base == 'versions.yml' ? "${task.hash}.versions.yml" : name
        }]
    withName: 'PREPARE_REFERENCES' {
        publishDir = [path: { "${params.outdir}/pipeline_info/reference" }, mode: 'copy', pattern: '*.{sha256,yml}']
    }
    withName: 'STAR_GENOMEGENERATE' {
        // Index remains a Nextflow cache product, not another output copy.
        publishDir = [enabled: false]
    }
    withName: 'KATANA_EXPORT' {
        // Complete runs retain these inputs in katana/project. Only an
        // upstream-only run publishes the separate interchange bundle.
        publishDir = [path: { params.outdir }, mode: 'copy', pattern: 'katana_bundle',
            enabled: "${ -> params.mode == 'upstream-only' }"]
    }
    withName: 'FASTQC' {
        publishDir = [path: { destination('rnaseq/qc/fastqc', 'upstream/fastqc') }, mode: 'copy']
    }
    withName: 'TRIMGALORE' {
        publishDir = [path: { destination('rnaseq/qc/trimming', 'upstream/trimgalore') }, mode: 'copy',
            saveAs: { name -> name.toString() ==~ /.*\.(fq|fastq)(\.gz)?/ ? null : name }]
    }
    withName: 'STAR_ALIGN' {
        // Publish diagnostics now; sorted BAM is published by SAMTOOLS_SORT.
        publishDir = [path: { destination('rnaseq/star', 'upstream/star_align') }, mode: 'copy',
            saveAs: { name -> name.toString() ==~ /.*\.(bam|fq|fastq)(\.gz)?/ ? null : name }]
    }
    withName: 'SAMTOOLS_SORT' {
        publishDir = [path: { destination('rnaseq/bam', 'bam') }, mode: 'copy', pattern: '*.bam',
            enabled: "${ -> params.storage_mode != 'lean' }"]
    }
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [path: { destination('rnaseq/bam', 'bam') }, mode: 'copy', pattern: '*.bai',
            enabled: "${ -> params.storage_mode != 'lean' }"]
    }
    withName: 'SALMON_GENOME_PROJECTION' {
        publishDir = [path: { destination('rnaseq/salmon', params.storage_mode == 'lean' ? 'native_models/salmon' : 'quant') },
            mode: 'copy', saveAs: { name -> name == 'versions.yml' ? null : name }]
    }
    withName: 'TXIMPORT' {
        publishDir = [path: { "${params.outdir}/rnaseq/matrices" }, mode: 'copy']
    }
    withName: 'RMATS_POST(_SINGLE)?' {
        publishDir = [path: { destination('rnasplicing/rmats', 'upstream/rmats_post') }, mode: 'copy',
            saveAs: { name -> name.toString().tokenize('/').any { it in ['tmp', 'rmats_temp'] } ? null : name }]
    }
    withName: 'RMATS_PREP(_SINGLE)?' {
        publishDir = [path: { "${params.outdir}/rnasplicing/rmats/logs" }, mode: 'copy',
            saveAs: { name -> name.toString().endsWith('.log') ? name : null }]
    }
    withName: '(CAPTURE_BAM_AUDIT|AUDIT_GENOME_BAM)' {
        publishDir = [path: { "${params.outdir}/rnaseq/qc/bam/${meta.id}" }, mode: 'copy',
            saveAs: { name -> name == 'katana_source.bam' ? null : name }]
    }
    withName: 'DEXSEQ_ANNOTATION' {
        publishDir = [path: { "${params.outdir}/differential/dexseq_exon/annotation" }, mode: 'copy', pattern: '*.gff']
    }
    withName: 'DEXSEQ_COUNT' {
        publishDir = [path: { "${params.outdir}/differential/dexseq_exon/counts" }, mode: 'copy', pattern: '*.clean.count.txt']
    }
    withName: '.*SUPPA.*' {
        publishDir = [path: { destination("rnasplicing/suppa/${task.process.tokenize(':')[-1].toLowerCase()}",
            "upstream/${task.process.tokenize(':')[-1].toLowerCase()}") }, mode: 'copy']
    }
    withName: 'DEXSEQ_EXON' {
        publishDir = [path: { destination('differential/dexseq_exon', params.storage_mode == 'lean' ? 'native_models/dexseq_exon' : 'dexseq_exon') },
            mode: 'copy', pattern: '*.{csv,rds,pdf}']
    }
    withName: '(DEXSEQ_DTU|STAGER)' {
        publishDir = [path: { destination("differential/dtu/${task.process.tokenize(':')[-1].toLowerCase()}",
            "dtu/results/${task.process.tokenize(':')[-1].toLowerCase()}") }, mode: 'copy', pattern: '*.{tsv,rds}']
    }
    withName: 'KATANA_(TXIMPORT|DESEQ2_CONTRAST|NORMALIZE|DESEQ2_METADATA)' {
        publishDir = [path: { destination('differential/deg', params.storage_mode == 'lean' ? 'native_models/DEG' : 'DEG') }, mode: 'copy']
    }
    withLabel: katana_downstream {
        errorStrategy = { task.exitStatus in [104, 130, 134, 137, 139, 143, 175, 176, 177] ? 'retry' : 'terminate' }
        publishDir = [path: { destination('katana/tasks', 'downstream') }, mode: 'copy',
            enabled: "${ -> params.storage_mode != 'lean' }"]
    }
    withName: 'KATANA_FLOW_COLLECT' {
        // The final retained project contains this collection once.
        publishDir = [path: { params.outdir }, mode: 'copy',
            enabled: "${ -> !params.native_delivery && params.storage_mode == 'lean' }"]
    }
    withName: 'KATANA_FLOW_RETAIN' {
        publishDir = [path: { "${params.outdir}/katana" }, mode: 'copy', failOnError: true]
    }
    withName: 'KATANA_FLOW_DELIVERY' {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy', failOnError: true]
    }
}
