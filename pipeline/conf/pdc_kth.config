// Opt-in Dardel profile. Other installations retain their own executor/queues.
// PDC documentation: https://pdc-web.eecs.kth.se/doc/run_jobs/job_scheduling/
// The shared CPU budget is a routing preference, not a concurrency limit.
params {
    pdc_shared_max_cpus = 64
    pdc_shared_memory_per_cpu_mb = 888
    clusterOptions = null
}

def explicitPartition = { options ->
    options != null && (options.toString() =~ /(^|\s)(-p\s*\S+|--partition(?:=|\s+)\S+)/).find()
}

process {
    executor = 'slurm'
    beforeScript = 'module load PDC apptainer'
    clusterOptions = {
        def account = params.slurm_account ?: params.project
        if (!account || !(account.toString() ==~ /[A-Za-z0-9_.-]+/))
            throw new IllegalArgumentException('Dardel requires --project YOUR_ALLOCATION (or --slurm_account).')
        "--account=${account}" + (params.clusterOptions ? " ${params.clusterOptions}" : '')
    }
    queue = {
        // Explicit CLI partition, user withName queue or clusterOptions remain
        // possible. Do not emit a second -p when the user's options supply one.
        if (explicitPartition(params.clusterOptions)) return null
        if (params.slurm_partition) return params.slurm_partition
        def perCpu = params.pdc_shared_memory_per_cpu_mb as double
        def sharedBudget = params.pdc_shared_max_cpus as int
        if (perCpu <= 0 || sharedBudget < 1)
            throw new IllegalArgumentException('Dardel shared routing budgets must be positive.')
        def schedulerCpus = Math.max(task.cpus as int, Math.ceil(task.memory.toMega() / perCpu) as int)
        if (task.time > 7.d)
            throw new IllegalArgumentException('Dardel supports at most 7 days; set a suitable task time.')
        if (schedulerCpus <= sharedBudget && task.memory <= 111.GB) return 'shared'
        if (task.time <= 24.h && task.memory <= 894.GB) return 'main'
        if (task.time <= 7.d && task.memory <= 222.GB) return 'long'
        throw new IllegalArgumentException('Request exceeds main/long capacity. Explicitly select --slurm_partition memory if appropriate; Katana never selects memory automatically.')
    }
}

executor {
    queueSize = 0
    $local { cpus = 8; memory = 128.GB }
}

singularity.runOptions = '-B /cfs/klemming/'
apptainer.runOptions = '-B /cfs/klemming/'
