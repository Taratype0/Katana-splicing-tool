// Resource-only mappings from pinned nf-core releases. Tool versions, commands,
// model formulas and scientific outputs are unchanged. See resource-policy.json.
// Match Katana aliases rather than upstream workflow prefixes that do not exist
// in this DAG. Site/user configuration remains separate and can override these.
process {
    // rnaseq 3.27.0 conf/modules/trimgalore.config, process_medium time.
    withName: 'TRIMGALORE' {
        cpus = { 8 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    // rnaseq 3.27.0 and rnasplice 2.0.0 FASTQC: process_low.
    withName: 'FASTQC' {
        cpus = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    // rnasplice 2.0.0 DEXSEQ_COUNT/PREPAREANNOTATION: process_single.
    withName: 'DEXSEQ_(COUNT|ANNOTATION)' {
        cpus = 1
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    // rnasplice 2.0.0 DEXSEQ_EXON/DTU: process_medium.
    withName: 'DEXSEQ_EXON' {
        cpus = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withName: 'DEXSEQ_DTU' {
        cpus = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    // differentialabundance 1.5.0 and 2.0.0 DESEQ2_DIFFERENTIAL:
    // process_single. Katana's normalization-only stage is also serial.
    withName: 'KATANA_(DESEQ2_CONTRAST|NORMALIZE)' {
        cpus = 1
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    // rnaseq 3.27.0 SAMTOOLS_FAIDX/CAT_FASTQ: process_single. STAGE_FASTQ
    // additionally validates lane identities but still merges serially.
    withName: '(REFERENCE_FAIDX|STAGE_FASTQ)' {
        cpus = 1
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
}
