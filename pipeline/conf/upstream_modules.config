// Publication policy only: channels, task outputs and scientific arguments stay
// unchanged. In lean mode the verified katana_bundle is the canonical upstream
// product; intermediate reads/BAMs are not copied into a second output tree.
// Defer parameter resolution until task execution: profiles or an extra -c
// file can override the defaults after this config file has been included.
def leanStorage = { params.storage_mode == 'lean' }
def leanIntermediateName = { name ->
    def parts = name.toString().tokenize('/')
    def base = parts.last().toLowerCase()
    // Remove only known read/alignment/reference copies and temporary trees.
    // Other native statistics, fitted R objects, diagnostics and unfamiliar
    // scientific file formats remain deliverables rather than implicit cache.
    base ==~ /.*\.(fastq|fq|bam|bai|cram|crai|sam|fasta|fa|fna|gtf|gff)(\.(gz|bz2|xz|zip))?/ ||
        parts.any { it.toLowerCase() in ['rmats_temp', 'tmp', '_startmp'] }
}

process {
    publishDir = [path: { "${params.outdir}/upstream/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: "${ -> params.storage_mode == 'lean' ? 'copy' : params.publish_dir_mode }",
        saveAs: { name ->
            if (leanStorage() && leanIntermediateName(name)) return null
            name == 'versions.yml' ? "${task.hash}.versions.yml" : name
        }]
    withName: 'VALIDATE_INPUTS' { publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: 'copy'] }
    withName: 'PREPARE_REFERENCES' { publishDir = [path: { "${params.outdir}/refs" }, mode: 'copy', enabled: "${ -> params.storage_mode != 'lean' }"] }
    withName: 'STAGE_FASTQ' {
        // Canonical raw-read symlinks are work inputs, not extra deliverables.
        // Each sample writes the same audit filename; keep their reports apart.
        publishDir = [path: { "${params.outdir}/pipeline_info/fastq_staging/${meta.id}" },
            mode: 'copy', pattern: 'fastq_staging_audit.json']
    }
    withName: '(CAPTURE_BAM_AUDIT|AUDIT_GENOME_BAM)' {
        // These tasks emit fixed audit filenames for each sample. Publish
        // separate sample directories and omit the staged passthrough BAM.
        publishDir = [
            path: { "${params.outdir}/upstream/${task.process.tokenize(':')[-1].toLowerCase()}/${meta.id}" },
            mode: "${ -> params.storage_mode == 'lean' ? 'copy' : params.publish_dir_mode }",
            saveAs: { name ->
                if (name == 'katana_source.bam') return null
                if (leanStorage() && leanIntermediateName(name) && !name.toString().endsWith('.header.sam')) return null
                name
            }
        ]
    }
    withName: 'STAR_GENOMEGENERATE' {
        // The upstream Galaxy artifact is legacy SquashFS. Pull its identical
        // fixed Quay tag as SIF; the observed STAR version is 2.7.9a.
        ext.singularity_pull_docker_container = true
        ext.args = { "--sjdbOverhang ${params.star_sjdb_overhang}" + (params.star_genome_sa_index_nbases != null ? " --genomeSAindexNbases ${params.star_genome_sa_index_nbases}" : '') }
        // A generated STAR index is rebuildable cache. Retain keeps the legacy
        // copy; lean uses it through channels without another published copy.
        // A supplied shared index is never copied or deleted by this process.
        publishDir = [path: { "${params.outdir}/reference_index" }, mode: 'copy', enabled: "${ -> params.storage_mode != 'lean' }"]
    }
    withName: 'STAR_ALIGN' {
        ext.singularity_pull_docker_container = true
        ext.args = '--twopassMode Basic --outSAMtype BAM Unsorted --readFilesCommand gunzip -c --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMattributes NH HI AS NM MD --outSAMunmapped Within'
    }
    withName: '(CREATE_BAMLIST.*|SPLIT_FILES_.*|CLUSTERGROUPS_.*)' {
        // These fixed upstream Galaxy artifacts are also legacy SquashFS.
        ext.singularity_pull_docker_container = true
    }
    withName: 'RMATS_PREP(_SINGLE)?' {
        // The .rmats records feed POST; they are not additional final results.
        publishDir = [path: { "${params.outdir}/upstream/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: "${ -> params.storage_mode == 'lean' ? 'copy' : params.publish_dir_mode }",
            saveAs: { name ->
                def base = name.toString().tokenize('/').last()
                if (leanStorage() && !(base.endsWith('.log') || base == 'versions.yml')) return null
                name == 'versions.yml' ? "${task.hash}.versions.yml" : name
            }]
    }
    withName: 'SAMTOOLS_SORT' { ext.prefix = { "${meta.id}.coordinate" }; publishDir = [path: { "${params.outdir}/bam" }, mode: 'copy', pattern: '*.bam', enabled: "${ -> params.storage_mode != 'lean' }"] }
    withName: 'SAMTOOLS_INDEX' { publishDir = [path: { "${params.outdir}/bam" }, mode: 'copy', pattern: '*.bai', enabled: "${ -> params.storage_mode != 'lean' }"] }
    // quant.sf enters the canonical bundle. Keep the native quantification
    // directory too: its declared directory output also contains aux_info,
    // lib_format_counts and command metadata not present in that bundle.
    withName: 'SALMON_GENOME_PROJECTION' { publishDir = [path: { leanStorage() ? "${params.outdir}/native_models/salmon" : "${params.outdir}/quant" }, mode: 'copy', pattern: '*', saveAs: { name -> name == 'versions.yml' ? null : name }] }
    withName: 'GFFREAD_TX2GENE' { ext.args = '--table transcript_id,gene_id,gene_name' }
    withName: 'DEXSEQ_ANNOTATION' { ext.prefix = 'DEXSeq'; publishDir = [path: { "${params.outdir}/dexseq_exon/annotation" }, mode: 'copy', pattern: '*.gff', enabled: "${ -> params.storage_mode != 'lean' }"] }
    withName: 'DEXSEQ_COUNT' { publishDir = [path: { "${params.outdir}/dexseq_exon/counts" }, mode: 'copy', pattern: '*.clean.count.txt', enabled: "${ -> params.storage_mode != 'lean' }"] }
    withName: 'DEXSEQ_EXON' { publishDir = [path: { leanStorage() ? "${params.outdir}/native_models/dexseq_exon" : "${params.outdir}/dexseq_exon" }, mode: 'copy', pattern: "${ -> params.storage_mode == 'lean' ? '*.{rds,pdf}' : '*.{csv,rds,pdf}' }"] }
    withName: 'DEXSEQ_DTU' { publishDir = [path: { leanStorage() ? "${params.outdir}/native_models/dtu/dexseq" : "${params.outdir}/dtu/results/dexseq" }, mode: 'copy', pattern: "${ -> params.storage_mode == 'lean' ? '*.rds' : '*.{tsv,rds}' }"] }
    withName: 'STAGER' { publishDir = [path: { leanStorage() ? "${params.outdir}/native_models/dtu/stager" : "${params.outdir}/dtu/results/stager" }, mode: 'copy', pattern: "${ -> params.storage_mode == 'lean' ? '*.rds' : '*.{tsv,rds}' }"] }
    // This selector also overrides the importer process's inline publishDir.
    withName: 'KATANA_(TXIMPORT|DESEQ2_CONTRAST|NORMALIZE|DESEQ2_METADATA)' { publishDir = [path: { leanStorage() ? "${params.outdir}/native_models/DEG" : "${params.outdir}/DEG" }, mode: 'copy'] }
    withName: 'KATANA_EXPORT' { publishDir = [path: { params.outdir }, mode: 'copy', pattern: 'katana_bundle'] }
}

