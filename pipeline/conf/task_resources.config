// Portable tool requests. Queue names, accounts and executors belong to the site.
// These are initial allocations, not guarantees that every dataset will fit.
def workflowResources = [
    'flow.qc.genebody':    [cpus: 1, memory: 4.GB, time: 12.h],
    'flow.qc.sequencing':  [cpus: 1, memory: 4.GB, time: 2.h],
    'flow.reference.bed12':[cpus: 1, memory: 4.GB, time: 2.h],
    'project.audit':      [cpus: 1, memory: 4.GB, time: 2.h]
]
def groupResources = [
    network_fit:      [cpus: 12, memory: 72.GB, time: 16.h],
    motiftrace:       [cpus: 6, memory: 36.GB, time: 8.h],
    mapp_prepare:     [cpus: 6, memory: 36.GB, time: 8.h],
    mapp:             [cpus: 6, memory: 36.GB, time: 8.h],
    network_followup: [cpus: 2, memory: 12.GB, time: 4.h],
    qc:              [cpus: 1, memory: 4.GB, time: 12.h],
    reference:       [cpus: 1, memory: 4.GB, time: 2.h],
    audit:           [cpus: 1, memory: 4.GB, time: 2.h]
]
def requestFor = { spec ->
    workflowResources.get(spec.workflow_id) ?: groupResources.get(spec.execution_group) ?: [cpus: 2, memory: 12.GB, time: 4.h]
}

process {
    // These imported/custom commands have no thread-count argument in their
    // current invocation. Keep their existing memory/time requests: those scale
    // with annotation/input size independently of whether the tool is serial.
    withName: '(^|.*:)(DEXSEQ_COUNT|DEXSEQ_ANNOTATION|REFERENCE_FAIDX|STAGE_FASTQ|PREPARE_REFERENCES)' {
        cpus = 1
    }
    withLabel: katana_downstream {
        // A memory failure does not demonstrate a need for more worker threads.
        // Keep CPUs fixed on retry, including serial RSeQC BAM traversal.
        cpus = { spec.resources?.cpus ?: requestFor(spec).cpus }
        memory = { (spec.resources?.memory ? spec.resources.memory as nextflow.util.MemoryUnit : requestFor(spec).memory) * task.attempt }
        time = { (spec.resources?.time ? spec.resources.time as nextflow.util.Duration : requestFor(spec).time) * task.attempt }
    }
    // Inference streams alignments; GFFREAD has no parallel-thread option here.
    // Override resources without modifying the imported upstream tools.
    withName: '(^|.*:)(RSEQC_INFEREXPERIMENT|GFFREAD_STRAND_MODELS)' {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
}
