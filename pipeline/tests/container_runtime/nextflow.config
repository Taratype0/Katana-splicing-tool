params {
    image = null
    uid = null
    gid = null
    outdir = null
    trace_file = 'trace.tsv'
}
process.executor = 'local'
docker.enabled = true
docker.runOptions = "--network none --user ${params.uid}:${params.gid}"
trace {
    enabled = true
    file = params.trace_file
    fields = 'task_id,hash,name,status,exit,container,workdir'
}
