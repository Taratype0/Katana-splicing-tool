// Native local execution with synthetic protocol data; never a release profile.
// A selected container name is recorded even with no engine enabled. This
// fixture validates dispatch only; it never claims container execution.
params.katana_stage_containers = [network_fit: 'fixture-network-image', network_followup: 'fixture-followup-image']
// This fixture covers transport, not the real retained-project format.
params.native_delivery = false
params.output_layout = 'legacy'
process {
    cpus = 1
    memory = 128.MB
    time = 5.min
    withLabel: katana_control { cpus = 1; memory = 128.MB; time = 5.min }
    withLabel: katana_downstream { cpus = 1; memory = 128.MB; time = 5.min }
    withLabel: katana_report { cpus = 1; memory = 128.MB; time = 5.min }
}
