// Native local execution with synthetic protocol data; never a release profile.
process {
    cpus = 1
    memory = 128.MB
    time = 5.min
    withLabel: katana_control { cpus = 1; memory = 128.MB; time = 5.min }
    withLabel: katana_downstream { cpus = 1; memory = 128.MB; time = 5.min }
    withLabel: katana_report { cpus = 1; memory = 128.MB; time = 5.min }
}
