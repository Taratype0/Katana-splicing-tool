  "purpose": [
    "Apply already approved pseudogene and mitochondrial exclusions before native differential inputs",
    "Export raw reference, filter decisions and receipt alongside the filtered analysis reference",
    "Carry existing FASTQ/trim/STAR QC artifacts into the portable upstream bundle",
    "Omit the unused MultiQC publish selector when including only the executable upstream core",
    "Bind native QC sources to exact sample IDs and raw/trimmed/alignment phases in the portable bundle",
    "Preserve declared reference, assay and pre-analysis exclusion provenance through bundle export and verified import",
    "Qualify BioContainers Docker image names with quay.io while retaining all tool versions, scripts and Singularity URLs",
    "Require an explicitly built DEXSeq tools image instead of the unpublished placeholder; preserve native scripts and parameters"
  ],
  "scientific_test_algorithms_replaced": false,
  "already_completed_results_refitted": false
}
