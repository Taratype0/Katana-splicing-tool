// Katana example for Dardel, loaded with -c kth.config.
// Use -profile slurm,apptainer and --slurm_account YOUR_ALLOCATION.
// This is not the nf-core/configs pdc_kth institutional profile.
process {
    executor = 'slurm'
    queue = 'shared'
}
apptainer {
    enabled = true
    autoMounts = true
    runOptions = '-B /cfs/klemming'
}
// Queue changes are explicit per-task choices; no memory-based routing.
// Load the site's Nextflow/Java/Apptainer modules in your launch environment.
