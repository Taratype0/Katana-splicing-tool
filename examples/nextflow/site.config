// Example only: replace account/partition and size resources for your study.
// Native Nextflow: -profile slurm,apptainer -c site.config
// Managed command: --profile slurm,apptainer --site-config site.config
params.slurm_account = 'YOUR_ACCOUNT'
params.slurm_partition = 'YOUR_PARTITION'

process {
    // Fully qualified aliases from workflows/katana_downstream.nf.
    withName: '.*:NETWORK_FIT' {
        cpus = 16
        memory = '64 GB'
        time = '24 h'
    }
    withName: '.*:MOTIFTRACE(_RESOURCE)?' {
        cpus = 8
        memory = '32 GB'
        time = '24 h'
    }
    withName: '.*:MAPP(_PREPARE)?' {
        cpus = 4
        memory = '16 GB'
        time = '24 h'
    }
}

// These are example requests, not measured guarantees or universal defaults.
// In particular, full event-by-event TOM can need much more than 64 GB.
// No automatic partition change or fixed concurrency ceiling is configured.
